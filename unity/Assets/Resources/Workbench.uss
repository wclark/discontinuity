.app { flex-grow: 1; background-color: rgb(236, 240, 239); color: rgb(37, 48, 46); -unity-font-definition: initial; font-size: 13px; }
Label { white-space: normal; }
Button { border-radius: 3px; border-width: 0; margin: 0; padding: 7px 11px; background-color: rgb(222, 229, 226); color: rgb(32, 55, 49); -unity-text-align: middle-center; }
Button:hover { background-color: rgb(206, 220, 213); }
Button:focus { border-color: rgb(48, 136, 115); border-width: 1px; }
.header { height: 86px; min-height: 86px; background-color: rgb(29, 38, 36); flex-direction: row; align-items: center; padding: 12px 26px; color: rgb(235, 242, 238); }
.brand { width: 40%; }.title { font-size: 28px; -unity-font-style: bold; }.eyebrow { font-size: 10px; color: rgb(166, 188, 177); margin-top: 4px; }
.clock { flex-grow: 1; }.time { font-size: 28px; -unity-font-style: bold; }.header-buttons { flex-direction: row; align-items: center; }
.header-buttons Button { margin-left: 8px; }.subtle { background-color: rgba(120, 145, 133, .16); }.header .subtle { color: rgb(225, 235, 229); }
.primary { background-color: rgb(43, 124, 104); color: white; -unity-font-style: bold; padding: 10px 16px; }.primary:hover { background-color: rgb(36, 147, 116); }
.toolbar { height: 43px; min-height: 43px; flex-direction: row; align-items: center; padding: 0 24px; border-bottom-width: 1px; border-bottom-color: rgb(206, 216, 212); }
.caption { font-size: 10px; color: rgb(101, 119, 111); }.toolbar .caption { margin-right: 14px; }.tab { background-color: transparent; font-size: 12px; padding: 8px 10px; border-radius: 0; }.tab.selected { border-bottom-width: 2px; border-bottom-color: rgb(48, 134, 109); color: rgb(32, 112, 88); -unity-font-style: bold; }.status-line { flex-grow: 1; -unity-text-align: middle-right; color: rgb(106, 116, 111); font-size: 12px; }
.body { flex-grow: 1; flex-direction: row; min-height: 280px; }.map-panel { width: 32%; padding: 18px 20px 10px 22px; }.scene-panel { width: 35%; background-color: rgb(250, 252, 249); padding: 18px 24px 8px; border-left-width: 1px; border-left-color: rgb(210, 219, 215); border-right-width: 1px; border-right-color: rgb(210, 219, 215); }.inspector-panel { width: 33%; padding: 18px 18px 8px; }
.section-index { font-size: 10px; color: rgb(99, 120, 109); -unity-font-style: bold; margin-bottom: 10px; }.map { flex-grow: 1; min-height: 225px; margin-bottom: 12px; }.room { position: absolute; width: 106px; height: 76px; margin-left: -53px; margin-top: -38px; align-items: center; background-color: rgb(236, 240, 239); border-width: 1px; border-color: rgb(164, 182, 172); border-radius: 2px; padding-top: 8px; }.room-selected { border-width: 2px; border-color: rgb(49, 126, 102); background-color: rgb(224, 236, 228); }.room-name { font-size: 10px; color: rgb(72, 96, 83); -unity-font-style: bold; }.occupants { flex-direction: row; height: 30px; align-items: center; justify-content: center; }.token { width: 21px; height: 21px; margin: 1px; padding: 0; border-radius: 10px; color: white; font-size: 11px; -unity-font-style: bold; }.map-item { font-size: 8px; color: rgb(45, 114, 161); -unity-font-style: bold; }
.person-row { flex-direction: row; align-items: center; height: 29px; border-bottom-width: 1px; border-bottom-color: rgb(214, 222, 218); }.person-dot { width: 6px; height: 6px; margin-right: 8px; border-radius: 3px; }.person-name { background-color: transparent; -unity-text-align: middle-left; width: 110px; padding: 0; }.person-location { flex-grow: 1; font-size: 11px; color: rgb(100, 117, 109); }.person-score { width: 25px; -unity-text-align: middle-right; color: rgb(40, 116, 91); }.house-note { margin-top: 15px; }.body-copy { font-size: 12px; margin-top: 5px; color: rgb(69, 86, 77); }
.scene-title { font-size: 29px; -unity-font-style: bold; margin-bottom: 7px; }.concern { font-size: 12px; color: rgb(85, 107, 95); margin-bottom: 12px; }.inventory { font-size: 10px; color: rgb(47, 126, 111); margin-bottom: 14px; padding-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgb(217, 225, 219); }.scene-scroll { flex-grow: 1; }.prose { font-size: 15px; color: rgb(47, 55, 50); margin-bottom: 12px; }.event-prose .caption { margin-bottom: 4px; }.action-heading { font-size: 10px; color: rgb(104, 117, 109); -unity-font-style: bold; margin-top: 13px; margin-bottom: 9px; }.choice { margin: 0 8px 6px 0; border-width: 1px; border-color: rgb(211, 221, 214); background-color: rgb(244, 248, 244); padding: 9px 12px; }.choice-line { flex-direction: row; align-items: center; }.choice-label { flex-grow: 1; font-size: 13px; -unity-text-align: middle-left; }.choice-score { width: 30px; -unity-text-align: middle-right; -unity-font-style: bold; color: rgb(44, 126, 96); }.choice-detail { font-size: 10px; color: rgb(131, 144, 135); -unity-text-align: middle-left; margin-top: 3px; }.ending { font-size: 19px; margin: 15px 0; }
.inspect-people { flex-direction: row; }.inspect-tabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: rgb(206, 217, 208); margin-bottom: 12px; }.inspect-tabs .tab { font-size: 11px; }.inspect-scroll { flex-grow: 1; }.inspector-name { font-size: 16px; -unity-font-style: bold; margin: 0 0 11px; }.option-fold { padding: 8px 0; border-bottom-width: 1px; border-bottom-color: rgb(208, 219, 211); font-size: 12px; }.equation { color: rgb(37, 119, 99); font-size: 11px; margin: 8px 0; }.term { margin: 4px 8px 6px 0; padding: 4px 0 4px 8px; border-left-width: 2px; border-left-color: rgb(189, 204, 192); }.active-term { border-left-color: rgb(46, 143, 109); }.term-amount { font-size: 11px; -unity-font-style: bold; color: rgb(69, 112, 88); }.term-copy { font-size: 11px; color: rgb(103, 119, 109); margin-top: 3px; }.muted { color: rgb(115, 129, 119); font-size: 12px; margin: 8px 0; }.manual-note { color: rgb(158, 108, 41); font-size: 11px; margin: 6px 0; }.rule { padding: 10px 6px 12px 0; border-bottom-width: 1px; border-bottom-color: rgb(210, 221, 212); }.rule-name { font-size: 12px; -unity-font-style: bold; margin-bottom: 5px; }.blocked-copy { font-size: 11px; color: rgb(126, 134, 126); margin: 7px 0; }.effect { color: rgb(41, 127, 100); font-size: 11px; margin: 5px 0; }.comparison { background-color: rgb(229, 220, 206); padding: 8px; font-size: 11px; margin-top: 10px; }.cause-link { font-size: 11px; -unity-text-align: middle-left; margin-bottom: 5px; }
.timeline-panel { height: 198px; min-height: 198px; border-top-width: 1px; border-top-color: rgb(191, 208, 196); padding: 10px 26px; background-color: rgb(231, 237, 232); }.timeline-heading { flex-direction: row; align-items: center; height: 29px; margin-bottom: 2px; }.timeline-heading .section-index { margin-bottom: 0; margin-right: 20px; }.timeline-heading Button { padding: 4px 9px; font-size: 11px; }.legend { flex-grow: 1; -unity-text-align: middle-right; font-size: 10px; color: rgb(103, 122, 110); }.track { flex-direction: row; height: 28px; align-items: center; }.track-name { width: 112px; min-width: 112px; font-size: 11px; -unity-font-style: bold; }.tick { flex-grow: 1; flex-basis: 0; -unity-text-align: middle-center; font-size: 10px; color: rgb(120, 133, 122); }.cell { flex-grow: 1; flex-basis: 0; height: 21px; margin: 0 3px; padding: 0; background-color: rgb(222, 230, 222); color: rgb(63, 86, 67); font-size: 10px; }.now-cell { border-left-width: 2px; border-left-color: rgb(39, 130, 95); }.changed-cell { border-bottom-width: 2px; border-bottom-color: rgb(181, 127, 54); }.guided-cell { border-top-width: 2px; border-top-color: rgb(164, 107, 36); }.selected-cell { border-width: 2px; border-color: rgb(40, 114, 86); }
.footer { height: 42px; min-height: 42px; padding: 5px 26px; flex-direction: row; align-items: center; border-top-width: 1px; border-top-color: rgb(210, 220, 212); }.footer .caption { margin-right: 12px; }.experiment { font-size: 11px; padding: 6px 9px; margin-right: 5px; background-color: rgb(224, 231, 224); }.footer-note { flex-grow: 1; -unity-text-align: middle-right; font-size: 10px; color: rgb(106, 122, 111); }
ScrollView { min-width: 0; }.unity-scroller--vertical { width: 10px; }.unity-base-slider__label { min-width: 65px; font-size: 11px; }
