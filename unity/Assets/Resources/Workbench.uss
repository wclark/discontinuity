.app { flex-grow: 1; background-color: rgb(246, 248, 246); color: rgb(35, 46, 41); font-size: 14px; }
Label { white-space: normal; margin: 0; }
Button { border-width: 0; border-radius: 3px; margin: 0; color: rgb(38, 66, 55); background-color: transparent; }
Button:hover { background-color: rgb(225, 236, 229); }
Button:focus { border-width: 1px; border-color: rgb(56, 127, 99); }
.header { height: 72px; min-height: 72px; flex-direction: row; align-items: center; padding: 0 25px; background-color: rgb(28, 37, 33); color: rgb(238, 244, 239); }
.brand { flex-direction: row; align-items: center; }.brand-icon { width: 40px; height: 40px; margin-right: 12px; }.brand-title { font-size: 24px; -unity-font-style: bold; }
.incarnation { flex-grow: 1; font-size: 12px; margin-left: 28px; margin-right: 20px; color: rgb(184, 200, 190); }
.clock { align-items: flex-end; margin-right: 20px; }.time { font-size: 22px; -unity-font-style: bold; }.date { font-size: 9px; color: rgb(161, 181, 168); margin-top: 2px; }
.icon-button { width: 36px; height: 36px; padding: 0; font-size: 25px; color: rgb(220, 235, 224); background-color: rgba(150, 182, 160, .12); }.icon-button:hover { background-color: rgba(150, 182, 160, .25); }
.page-scroll { flex-grow: 1; }
.story-layout { width: 100%; flex-direction: row; padding: 26px; }
.story-world { flex-grow: 3; flex-basis: 0; min-width: 0; margin-right: 32px; }
.story-side { flex-grow: 2; flex-basis: 0; min-width: 0; padding-top: 11px; }
.narrow { flex-direction: column; }.narrow .story-world { margin-right: 0; }.narrow .story-side { padding-top: 24px; }
.scene-title { font-size: 30px; -unity-font-style: bold; margin-bottom: 16px; }
.scene-art { width: 100%; height: 440px; flex-shrink: 0; overflow: hidden; background-color: rgb(76, 90, 80); }
.room-painting { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.cast-stage { position: absolute; left: 8%; right: 8%; bottom: 18px; height: 64%; flex-direction: row; align-items: flex-end; justify-content: center; }
.cast-person { flex-grow: 1; flex-basis: 0; min-width: 0; max-width: 220px; height: 100%; }.character-image { width: 100%; height: 100%; }.departing { opacity: .55; }
.cast-captions { flex-direction: row; justify-content: center; min-height: 56px; background-color: rgb(234, 240, 234); }
.cast-caption { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 8px 5px; border-top-width: 3px; border-top-color: transparent; }
.acting-caption { border-top-color: rgb(164, 72, 69); }.cast-name { font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; }
.cast-activity { font-size: 11px; color: rgb(92, 110, 99); -unity-text-align: middle-center; margin-top: 4px; }.acting-caption .cast-activity { color: rgb(145, 56, 55); }
.room-description { font-size: 15px; color: rgb(71, 88, 77); margin: 15px 0; }
.context { flex-direction: row; flex-wrap: wrap; border-top-width: 1px; border-top-color: rgb(215, 226, 216); padding-top: 12px; }
.context-group { flex-grow: 1; min-width: 150px; margin-right: 16px; }.caption, .eyebrow { font-size: 10px; -unity-font-style: bold; color: rgb(94, 119, 103); }
.context-value { font-size: 13px; margin-top: 5px; }.story-title { font-size: 27px; -unity-font-style: bold; margin: 12px 0 18px; }
.prose { font-size: 18px; margin-bottom: 18px; }.concern { font-size: 14px; color: rgb(110, 90, 72); -unity-font-style: italic; margin-bottom: 20px; }
.action-row { flex-direction: row; align-items: stretch; border-top-width: 1px; border-top-color: rgb(210, 223, 215); min-height: 48px; }
.choice { flex-grow: 1; flex-basis: 0; min-width: 0; white-space: normal; -unity-text-align: middle-left; font-size: 16px; padding: 13px 12px; }
.inspect-button { width: 28px; height: 28px; min-width: 28px; align-self: center; margin: 6px 3px 6px 10px; border-radius: 14px; border-width: 1px; border-color: rgb(174, 194, 179); font-size: 14px; -unity-font-style: bold; color: rgb(101, 129, 111); padding: 0; }
.moment-button, .continue-button { align-self: flex-start; min-width: 175px; min-height: 44px; padding: 12px 24px; background-color: rgb(43, 116, 87); color: white; font-size: 16px; margin-top: 10px; }
.moment-button:hover, .continue-button:hover { background-color: rgb(46, 139, 102); }
.quiet-moments { border-top-width: 1px; border-top-color: rgb(210, 223, 215); padding-top: 18px; margin-top: 8px; margin-bottom: 14px; }
.quiet-copy { font-size: 14px; color: rgb(77, 98, 85); margin-top: 10px; }
.disclosure { font-size: 13px; color: rgb(84, 106, 93); }.journal { margin-top: 20px; padding-top: 12px; border-top-width: 1px; border-top-color: rgb(215, 226, 216); }
.journal-entry { margin: 14px 10px; }.event-time { font-size: 10px; color: rgb(103, 123, 112); margin-bottom: 5px; }.journal-prose { font-size: 14px; }
.past-factors { align-self: flex-start; margin-left: 0; }.notice { color: rgb(155, 58, 46); margin-top: 15px; }
.modal-backdrop { position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(12, 22, 17, .65); align-items: center; justify-content: center; }
.factor-modal { width: 640px; max-width: 90%; max-height: 85%; padding: 24px; background-color: rgb(247, 249, 247); border-radius: 6px; }
.modal-heading { flex-direction: row; align-items: center; margin-bottom: 18px; }.modal-title { flex-grow: 1; flex-shrink: 1; font-size: 23px; -unity-font-style: bold; }
.modal-close { min-width: 34px; width: 34px; height: 34px; margin-left: 12px; padding: 0; font-size: 24px; }
.modal-scroll { flex-shrink: 1; }.score-equation { font-size: 18px; -unity-font-style: bold; margin: 16px 0; color: rgb(43, 116, 87); }
.factor-copy { font-size: 13px; padding: 12px 0; border-top-width: 1px; border-top-color: rgb(214, 225, 215); }.adjustment { font-size: 14px; color: rgb(139, 83, 52); margin: 14px 0; }
.choice-score { width: 58px; min-width: 58px; -unity-text-align: middle-right; font-size: 16px; -unity-font-style: bold; color: rgb(38, 101, 112); }
.action-tools { flex-direction: row; align-items: center; justify-content: flex-end; margin-bottom: 8px; }
.action-tools .icon-button { color: rgb(43, 116, 87); margin-left: 8px; }
.tool-button { min-height: 32px; padding: 7px 12px; font-size: 13px; align-self: flex-start; background-color: rgb(227, 236, 232); margin: 4px 0; white-space: normal; }
.section-label { font-size: 11px; -unity-font-style: bold; margin-top: 18px; margin-bottom: 10px; color: rgb(62, 91, 96); }
.criterion-met, .criterion-unmet { font-size: 13px; padding: 5px 0; }.criterion-met { color: rgb(40, 104, 80); }.criterion-unmet { color: rgb(158, 58, 58); }
.catalog-entry { padding: 9px 0; border-bottom-width: 1px; border-bottom-color: rgb(215, 226, 216); }
.catalog-action { -unity-text-align: middle-left; font-size: 15px; min-height: 34px; padding: 4px 0; white-space: normal; }
.editor-modal { width: 760px; height: 740px; }.editor-modal .modal-scroll { flex-grow: 1; }
.editor-tabs { flex-direction: row; border-bottom-width: 1px; border-bottom-color: rgb(178, 202, 193); margin-bottom: 14px; flex-shrink: 0; }
.editor-tab { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 12px 4px; font-size: 14px; white-space: normal; }
.editor-tab.selected { background-color: rgb(216, 234, 231); border-bottom-width: 3px; border-bottom-color: rgb(36, 108, 115); }
.editor-field { min-height: 30px; margin: 6px 0; }.editor-field .unity-base-field__label { min-width: 130px; }
.editor-pair { flex-direction: row; align-items: center; }.editor-pair > .editor-field { flex-grow: 1; flex-basis: 0; min-width: 0; }
.editor-pair .unity-base-field__label { min-width: 70px; }
.editor-pair > FloatField { flex-grow: 1; }
.editor-footer { flex-shrink: 0; padding-top: 12px; border-top-width: 1px; border-top-color: rgb(198, 216, 206); }
.editor-commands { flex-direction: row; justify-content: flex-end; align-items: center; }
.save-action { min-height: 36px; padding: 8px 18px; background-color: rgb(34, 111, 99); color: white; margin-left: 12px; font-size: 14px; }
.save-action:hover { background-color: rgb(47, 136, 121); }
.editor-error { font-size: 13px; color: rgb(160, 50, 50); margin-bottom: 6px; }
.condition-row, .rule-editor { border-bottom-width: 1px; border-bottom-color: rgb(205, 221, 212); padding: 10px 0; }
.prose-field { min-height: 68px; margin: 8px 0; }.prose-field .unity-base-field__label { min-width: 130px; }.prose-field .unity-text-field__input { white-space: normal; }
.effect-row { flex-direction: row; align-items: center; }.effect-row > .editor-field { flex-grow: 1; flex-basis: 0; min-width: 0; }
.effect-row .unity-base-field__label { min-width: 65px; }
.record-entry { min-height: 34px; white-space: normal; -unity-text-align: middle-left; padding: 8px 0; font-size: 12px; }
.record-status { margin: 10px 0; color: rgb(37, 109, 104); }
.header .icon-button { min-width: 36px; flex-shrink: 0; margin-left: 6px; }
.editor-field .unity-base-field__label, .prose-field .unity-base-field__label { padding-right: 8px; }
.mode-label { color: rgb(148, 201, 191); font-size: 10px; margin-right: 18px; }
.ranked-options { max-height: 400px; flex-shrink: 1; }.top-action { border-left-width: 3px; border-left-color: rgb(37, 118, 117); background-color: rgb(230, 241, 237); }
.turn-summary { margin-top: 15px; border-top-width: 1px; border-top-color: rgb(211, 225, 218); }
.summary-event { font-size: 14px; margin: 7px 0; }.weight-entry { font-size: 13px; padding: 10px 0; border-bottom-width: 1px; border-bottom-color: rgb(211, 225, 218); }
.action-tools .tool-button { margin-left: 7px; }
