      actor: merrow
      action: tend
      route: 
      from: 0
      until: 5
      amount: 6
      conditions:
      - key: owner:medicine
        value: merrow
        not: 0
    - id: m02
      actor: merrow
      action: 
      route: hall
      from: 5
      until: 15
      amount: 5
      conditions:
      - key: patient_tended
        value: yes
        not: 0
    - id: m03
      actor: merrow
      action: witness
      route: 
      from: 5
      until: 10
      amount: 8
      conditions:
      - key: owner:envelope
        value: vale
        not: 0
      - key: at:vale
        value: hall
