      route: archive
      from: 3
      until: 8
      amount: 6
      conditions:
      - key: owner:envelope
        value: archive
        not: 0
      - key: vale_left
        value: yes
        not: 1
    - id: v02
      actor: vale
      action: take
      route: 
      from: 3
      until: 9
      amount: 7
      conditions:
      - key: owner:envelope
        value: archive
        not: 0
    - id: v03
      actor: vale
      action: 
      route: chapel
      from: 5
